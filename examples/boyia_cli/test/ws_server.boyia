// WebSocket echo server for manual test with test/ws_client.py
// Run: cargo run -p boyia_cli -- test/ws_server.boyia
//
// Wrap in a class so anonymous callbacks in onReceive()/onClose() have mClass (capture this).

class WsEchoServer {
    prop server;

    prop fun run(host, port) {
        this.server = new(WebSocketServer);

        BY_Log("WebSocketServer: starting on ws://127.0.0.1:9122/");

        var started = this.server.start(host, port);
        BY_Log("WebSocketServer: start returned");

        if (!started) {
            BY_Log("WebSocketServer: failed to bind 127.0.0.1:9122");
            return;
        }

        BY_Log("WebSocketServer: listening (Ctrl+C to stop)");
        BY_Log("Run client: python3 test/ws_client.py");

        this.server.onReceive(fun(clientPort, msg) {
            if (msg == "") {
                return;
            }
            BY_Log("received on port " + clientPort + ": " + msg);
            this.server.send(clientPort, "echo: " + msg);
        });

        this.server.onClose(fun(clientPort, closeCode, reason) {
            BY_Log("client closed port:  " + clientPort + ", code: " + closeCode + ", reason: " + reason);
        });
    }
};

var app = new(WsEchoServer);
app.run("127.0.0.1", 9122);
